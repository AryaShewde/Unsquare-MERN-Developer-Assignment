{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/cron/verify.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/cron/verify", "destination": "/api/cron/verify.ts" },
    { "source": "/api/(.*)", "destination": "/api/index.ts" }
  ],
  "crons": [
    {
      "path": "/api/cron/verify",
      "schedule": "0 3 * * *"
    }
  ]
}
